# File: .env.example
# Purpose: Template for all environment variables needed by Docker Compose
# and the Spring Boot backend. Copy this file to .env and fill in values.
# Never commit .env to version control.
# All Rights Reserved Arodi Emmanuel

# --- PostgreSQL ---
DB_PASSWORD=change_me_strong_password
DB_NAME=poetry_db
DB_USER=poetry

# --- Spring Boot backend (runs on host, not in Docker) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
JWT_SECRET=change_me_256bit_base64_encoded_secret

# --- Hardware (fingerprint reader on host) ---
APP_HARDWARE_BASE_URL=http://localhost:3002

# --- Frontend ---
# Points to backend running on host, resolved by Nginx proxy
VITE_API_URL=http://localhost:8080
