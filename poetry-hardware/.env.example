# File: .env.example
# Purpose: Environment configuration template
# All Rights Reserved. Arodi Emmanuel

# Server Configuration
PORT=3001
NODE_ENV=development

# Hardware Mode
MOCK_MODE=true
LOG_LEVEL=debug

# Serial Ports (auto-detected if empty)
USB_TTL_PORT=
FINGERPRINT_PORT=

# Fingerprint Adapter: 'bridge' (R503) or 'hid' (Digital Persona)
FINGERPRINT_ADAPTER=bridge

# HID Digital Persona Configuration (only needed if FINGERPRINT_ADAPTER=hid)
DP_SERVICE_URL=ws://127.0.0.1:9000

# Relay Configuration
RELAY_CHANNELS=4
RELAY_DEFAULT_DELAY_MS=500

# Backend URL for verification
BACKEND_URL=http://localhost:8080

# API Security (add when integrating with backend)
API_KEY=
ALLOWED_ORIGINS=http://localhost:8080
